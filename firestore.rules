rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Allow anyone to view public collections (Notice board, Gallery, Sermons, etc.)
    match /announcements/{doc} { allow read: if true; }
    match /photos/{doc} { allow read: if true; }
    match /documents/{doc} { allow read: if true; }
    match /mipuiaw/{doc} { allow read: if true; }
    match /bulletins/{doc} { allow read: if true; }
    match /souvenirs/{doc} { allow read: if true; }
    match /news/{doc} { allow read: if true; }
    match /lawmpuina/{doc} { allow read: if true; }
    match /sunna/{doc} { allow read: if true; }
    match /kohhran-chanchin/{doc} { allow read: if true; }
    match /kohhran-upa/{doc} { allow read: if true; }
    match /golden-jubilee/{doc} { allow read: if true; }
    
    // Support exact names with spaces
    match /{collection}/{doc} {
      allow read: if collection == 'Kohhran Chanchin' || 
                       collection == 'Kohhran Upa' || 
                       collection == 'Golden Jubilee';
    }
    match /sermons/{doc} { allow read: if true; }
    match /lyrics/{doc} { allow read: if true; }
    match /settings/{doc} { allow read: if true; }
    match /about/{doc} { allow read: if true; }
    match /branch-info/{doc} { allow read: if true; }
    match /statistics/{doc} { allow read: if true; }
    match /contact_directory/{doc} { allow read: if true; }
    match /counselling/{doc} { 
      allow read: if true; 
      allow create: if true; // Allow anonymous question posting
    }
    match /messages/{doc} {
      allow create: if true; // Allow anonymous contact messages
    }

    // 2. Allow general authenticated users to write/edit their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Allow KTP Saikhamakawn administrators to write/update all collections
    match /{document=**} {
      allow read, write: if request.auth != null && 
        (request.auth.token.email.matches('.*@ktpsaikhamakawn\\.org$') || 
         request.auth.token.email == 'papuiarenthlei365@gmail.com');
    }
  }
}
